rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function auth(){ return request.auth != null; }
  function game(g){ return get(/databases/$(database)/documents/games/$(g)).data; }
  function owner(g){ return auth() && game(g).ownerUid == request.auth.uid; }
  match /games/{g} {
   allow get: if auth();
   allow list: if auth() && resource.data.ownerUid == request.auth.uid;
   allow create: if auth() && request.resource.data.ownerUid == request.auth.uid;
   allow update,delete: if owner(g);
   match /players/{pid} {
    allow read: if auth();
    allow create,delete: if owner(g);
    allow update: if owner(g) || (auth() && resource.data.uid == null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','lastSeen']) && request.resource.data.uid == request.auth.uid);
   }
   match /secrets/{pid} {
    allow read: if owner(g) || (auth() && get(/databases/$(database)/documents/games/$(g)/players/$(pid)).data.uid == request.auth.uid);
    allow create,delete: if owner(g);
    allow update: if owner(g) || (auth() && get(/databases/$(database)/documents/games/$(g)/players/$(pid)).data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes','vote','action']));
   }
   match /logs/{id} { allow read,write: if owner(g); }
   match /messages/{id} { allow read: if owner(g)||(auth()&&resource.data.toUid==request.auth.uid); allow write: if owner(g); }
   match /chat/{id} {
    allow read: if owner(g) || auth();
    allow create: if owner(g) || (auth() && request.resource.data.fromUid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size()>0 && request.resource.data.text.size()<=500);
    allow update,delete: if owner(g);
   }
  }
 }
}
