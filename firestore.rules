rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function authed(){ return request.auth != null; }
  function game(code){ return get(/databases/$(database)/documents/games/$(code)).data; }
  function owner(code){ return authed() && game(code).ownerUid == request.auth.uid; }
  function claimUid(code,seat){ return get(/databases/$(database)/documents/games/$(code)/seatClaims/$(seat)).data.uid; }
  function validText(){ return request.resource.data.text is string && request.resource.data.text.size()>0 && request.resource.data.text.size()<=500; }
  function publicOk(code){ let c=game(code).chat; return request.resource.data.kind=='public' && (c.publicMode=='all' || (c.publicMode=='selected' && request.resource.data.fromSeat in c.publicSeats)); }
  function privateOk(code){ let c=game(code).chat; let a=request.resource.data.fromSeat; let b=request.resource.data.toSeat; return request.resource.data.kind=='private' && b is string && ((a+'|'+b) in c.pairs || (b+'|'+a) in c.pairs) && claimUid(code,b)==request.resource.data.toUid; }
  match /games/{code} {
   allow get: if authed();
   allow list: if authed() && resource.data.ownerUid==request.auth.uid;
   allow create: if authed() && request.resource.data.ownerUid==request.auth.uid;
   allow update,delete: if owner(code);
   match /gm/{docId} { allow read,write: if owner(code); }
   match /joinKeys/{key} {
    allow get: if authed();
    allow list: if false;
    allow create,update,delete: if owner(code);
   }
   match /seatClaims/{seat} {
    allow read: if authed();
    allow create: if authed() && request.resource.data.uid==request.auth.uid && request.resource.data.joinKey is string && exists(/databases/$(database)/documents/games/$(code)/joinKeys/$(request.resource.data.joinKey)) && get(/databases/$(database)/documents/games/$(code)/joinKeys/$(request.resource.data.joinKey)).data.seatId==seat;
    allow update: if owner(code);
    allow delete: if owner(code);
   }
   match /private/{u} { allow read: if owner(code)||(authed()&&request.auth.uid==u); allow write: if owner(code); }
   match /notes/{u} { allow read,write: if authed()&&request.auth.uid==u; }
   match /actions/{u} { allow read: if owner(code)||(authed()&&request.auth.uid==u); allow create,update: if authed()&&request.auth.uid==u; allow delete: if owner(code); }
   match /votes/{u} { allow read: if authed(); allow create,update: if authed()&&request.auth.uid==u; allow delete: if owner(code)||(authed()&&request.auth.uid==u); }
   match /chat/{id} {
    allow read: if owner(code)||(authed()&&(resource.data.kind=='public'||resource.data.fromUid==request.auth.uid||resource.data.toUid==request.auth.uid));
    allow create: if (owner(code)&&request.resource.data.fromUid==request.auth.uid&&validText()) || (authed()&&request.resource.data.fromUid==request.auth.uid&&validText()&&claimUid(code,request.resource.data.fromSeat)==request.auth.uid&&(publicOk(code)||privateOk(code)));
    allow update,delete: if owner(code);
   }
  }
 }
}
